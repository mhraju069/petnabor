    "y": 19
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service=\"nginx\", log=\"access\"} |~ \"\\\" 5[0-9][0-9] \" |~ \"$search\"",
     "queryType": "range"
    }
   ],
   "options": {
    "showTime": true,
    "showLabels": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "prettifyLogMessage": false
   },
   "id": 4,
   "datasource": {
    "type": "loki",
    "uid": "loki"
   }
  },
  {
   "type": "logs",
