{
 "id": null,
 "uid": "petnabor-logs",
 "title": "PetNabor logs",
 "description": "Errors and logs from every service (Loki).",
 "tags": [
  "petnabor",
  "logs"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "type": "query",
    "name": "service",
    "label": "Service",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "service",
     "stream": "",
     "type": 1,
     "refId": "LokiVariableQueryEditor-VariableQuery"
    },
    "definition": "label_values(service)",
    "includeAll": true,
    "multi": true,
    "allValue": ".+",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "refresh": 2,
    "sort": 1
   },
   {
    "type": "textbox",
    "name": "search",
    "label": "Search (text or request id)",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Errors per service",
   "description": "Log lines mentioning an error, every 5 minutes.",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (service) (count_over_time({service=~\"$service\"} |~ \"(?i)(error|critical|traceback|exception)\" |~ \"$search\" [5m]))",
     "legendFormat": "{{service}}",
     "queryType": "range"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 70,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "id": 1,
   "datasource": {
    "type": "loki",
    "uid": "loki"
   }
  },
  {
   "type": "timeseries",
   "title": "Failed requests (nginx 5xx)",
   "description": "Requests nginx answered with a 5xx (app crashed, down or timed out).",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({service=\"nginx\", log=\"access\"} |~ \"\\\" 5[0-9][0-9] \" [5m]))",
     "legendFormat": "5xx",
     "queryType": "range"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 70,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "id": 2,
   "datasource": {
    "type": "loki",
    "uid": "loki"
   }
  },
  {
   "type": "logs",
   "title": "Errors & tracebacks",
   "description": "Newest first. Click a line \u2192 'Show context' for the full traceback around it. Click a req=\u2026 id to see everything that request did.",
   "gridPos": {
    "h": 12,
    "w": 24,
    "x": 0,
    "y": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service=~\"$service\"} |~ \"(?i)(error|critical|traceback|exception)\" |~ \"$search\"",
     "queryType": "range"
    }
   ],
   "options": {
    "showTime": true,
    "showLabels": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "prettifyLogMessage": false
   },
   "id": 3,
   "datasource": {
    "type": "loki",
    "uid": "loki"
   }
  },
  {
